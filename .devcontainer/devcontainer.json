{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [6081, 8080],
  "portsAttributes": {
    "6081": { "label": "Session 1", "onAutoForward": "silent" },
    "8080": { "label": "Session 2", "onAutoForward": "silent" }
  },
  "postStartCommand": "nohup bash /workspaces/simcode/startup.sh > /tmp/startup.log 2>&1 &"
}